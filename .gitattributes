# Нормализация переводов строк: LF в репозитории, автоконвертация при checkout
* text=auto eol=lf

# Windows-скрипты: сохранять CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы: без текстового diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.xlsx binary
*.pdf binary

# Исключать локальные файлы из git archive
AGENTS.md export-ignore
DEVLOG.md export-ignore
specs.md export-ignore
references/ export-ignore


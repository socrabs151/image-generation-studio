# Нормализация переводов строк: LF в репозитории, автоконвертация при checkout
* text=auto eol=lf

# Windows-скрипты: сохранять CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы: без текстового diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary

# Иконки приложения не наш код: не учитывать в статистике языка
resources/icons/ linguist-generated=true

# Исключить из git archive приватные файлы, если они всё же попали в индекс
AGENTS.md export-ignore
AUDIT.md export-ignore
DEVLOG.md export-ignore
specs.md export-ignore
references/ export-ignore

# Вендорская документация агрегаторов: чужая, не наш текст
docs/aitunnel/ linguist-vendored
docs/polzaai/ linguist-vendored
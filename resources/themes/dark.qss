/* Тёмная тема — Image Generation Studio (макет) */

QWidget {
    background-color: #1e1e2e;
    color: #e6e6f0;
    font-family: "Segoe UI";
    font-size: 9pt;
}

QMainWindow { background-color: #1e1e2e; }
QMenuBar { background-color: #27273a; }
QMenuBar::item { background: transparent; padding: 3px 10px; }
QMenuBar::item:selected { background: #3a3a52; }
QMenu { background-color: #27273a; padding: 2px; }
QMenu::item:selected { background: #3a3a52; }

QComboBox, QLineEdit, QSpinBox {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 4px;
    padding: 2px 6px;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover { border-color: #4a4a66; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus { border-color: #6c8cff; }
QComboBox::drop-down { border: none; width: 16px; }
QComboBox QAbstractItemView { background-color: #27273a; selection-background-color: #3a3a52; }

QPushButton {
    background-color: #2f2f45;
    border: 1px solid #3a3a52;
    border-radius: 4px;
    padding: 3px 10px;
}
QPushButton:hover { background-color: #3a3a52; }
QPushButton:pressed { background-color: #454563; }
QPushButton#primary {
    background-color: #6c8cff;
    color: #ffffff;
    border: 1px solid #5a7aff;
    font-weight: 600;
    padding: 4px 14px;
}
QPushButton#primary:hover { background-color: #5a7aff; }
QPushButton#danger { color: #f87171; border-color: #f87171; }
QPushButton#link { background: transparent; border: none; color: #6c8cff; }
QPushButton#link:hover { text-decoration: underline; }

QFrame#panel {
    background-color: #27273a;
    border: 1px solid #3a3a52;
    border-radius: 6px;
}
QLabel#panelTitle {
    background-color: transparent;
    color: #9a9ab0;
    font-size: 8pt;
    letter-spacing: 0.5px;
    padding: 1px 8px;
}
QWidget#dropArea {
    background-color: #1b1b29;
    border: 1px dashed #3a3a52;
    border-radius: 4px;
}
QWidget#dropArea QLabel {
    color: #9a9ab0;
}
QWidget#dropArea:focus {
    border-color: #6c8cff;
}
QLabel#resultEmpty {
    background-color: #1b1b29;
    border: 1px dashed #3a3a52;
    border-radius: 4px;
    color: #9a9ab0;
}
QLabel#hint { color: #9a9ab0; font-size: 8pt; font-style: italic; }

QTextEdit, QPlainTextEdit {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 4px;
    padding: 3px;
}
QStatusBar { background-color: #27273a; color: #9a9ab0; }
QSplitter::handle { background-color: #33334a; }
QScrollArea { border: none; }

/* Полосы прокрутки: без стрелок, узкая скруглённая ручка с подсветкой */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}
QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::handle:vertical {
    background: #4a4a66;
    border-radius: 5px;
    min-height: 36px;
}
QScrollBar::handle:horizontal {
    background: #4a4a66;
    border-radius: 5px;
    min-width: 36px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #5e5e86; }
QScrollBar::handle:vertical:active, QScrollBar::handle:horizontal:active { background: #6c8cff; }
QScrollBar::corner { background: transparent; }
QScrollArea#resultScroll > QWidget > QWidget { background-color: #1e1e2e; }
QLabel#canvas { background-color: #1b1b29; border: none; }

QLabel#resultThumb {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 6px;
}
QLabel#resultThumb:hover { border-color: #6c8cff; background-color: #232338; }
QLabel#resultError { color: #f87171; padding: 6px; }
QTextEdit#errorText { color: #fca5a5; background-color: #1b1b29; }

/* Просмотрщик картинок: холст, панели и плёнка */
QFrame#viewerTopBar { background-color: #20202f; border-bottom: 1px solid #2f2f45; }
QFrame#viewerBottomBar { background-color: #20202f; border-top: 1px solid #2f2f45; }
QLabel#viewerCounter { color: #e6e6f0; font-weight: 600; padding: 0 6px; }
QLabel#viewerZoom { color: #9a9ab0; }

/* Список моделей: поиск и избранное. Значок избранного — картинка, поэтому
   цвет задаётся в resources/icons/star, а здесь только рамка состояния. */
QLineEdit#modelSearch { padding: 3px 8px; }
QPushButton#favButton { padding: 2px 0; }
QPushButton#favButton:checked { border-color: #f5c451; }
QPushButton#favButton:disabled { border-color: #2f2f45; }
QPushButton#filmThumb {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 4px;
}
QPushButton#filmThumb:hover { border-color: #6c8cff; }
QPushButton#filmThumb:checked {
    border: 2px solid #6c8cff;
    background-color: #232338;
}
QPushButton[active="true"] { border-color: #6c8cff; color: #cfd8ff; }
QScrollArea#filmScroll { background-color: #20202f; border: none; }

/* Дерево документации: округлённое выделение вместо грубой полосы */
QTreeWidget#docsTree {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    /* The branch column of a selected row is painted with the palette highlight,
       which shows up as a coloured block on the left; keep it in step with the row. */
    selection-background-color: #2a2a42;
}
QTreeWidget#docsTree::item {
    padding: 5px 8px;
    border: none;
    border-radius: 5px;
    color: #c9c9d8;
}
QTreeWidget#docsTree::item:hover { background-color: #232338; color: #e6e6f0; }
QTreeWidget#docsTree::item:selected { background-color: #2a2a42; color: #9db4ff; }
QTreeWidget#docsTree::item:selected:hover { background-color: #32324e; }
QTreeWidget#docsTree::branch { background: transparent; }
QTreeWidget#docsTree::branch:has-children:closed {
    image: url(@ICONS@/docs/chevron-right.png);
}
QTreeWidget#docsTree::branch:has-children:open {
    image: url(@ICONS@/docs/chevron-down.png);
}
QLabel#docsTitle { font-size: 11pt; font-weight: 600; color: #e6e6f0; }
QTextBrowser#docsViewer { background-color: #1e1e2e; border: 1px solid #3a3a52; border-radius: 6px; }

/* Таблицы: тот же сдержанный стиль выделения, что и у дерева документации */
QTableWidget {
    background-color: #1b1b29;
    alternate-background-color: #1e1e2e;
    border: 1px solid #3a3a52;
    border-radius: 6px;
    gridline-color: #26263c;
    selection-background-color: #2a2a42;
    selection-color: #9db4ff;
    outline: none;
}
QTableWidget::item { padding: 3px 6px; color: #c9c9d8; }
QTableWidget::item:selected { background-color: #2a2a42; color: #9db4ff; }
QTableWidget::item:hover { background-color: #232338; }
QHeaderView::section {
    background-color: #27273a;
    color: #9a9ab0;
    border: none;
    border-bottom: 1px solid #3a3a52;
    padding: 5px 6px;
}
QScrollArea#thumbsScroll { background: transparent; border: none; }

/* Числовое поле «Кол-во»: своя обёртка вместо QSpinBox */
QFrame#numberField {
    background-color: #1b1b29;
    border: 1px solid #3a3a52;
    border-radius: 4px;
}
QFrame#numberField:hover { border-color: #4a4a66; }
QLineEdit#numberEdit {
    background: transparent;
    border: none;
    padding: 0 2px;
}
QToolButton#numberBtn {
    background: transparent;
    border: none;
    color: #9a9ab0;
    font-size: 7pt;
    padding: 0;
}
QToolButton#numberBtn:hover { background: #3a3a52; color: #e6e6f0; }
QToolButton#numberBtn:pressed { background: #454563; }